<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="366.0" minWidth="215.0" prefHeight="400.0" prefWidth="252.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.password_generator.view.MainWindow">
   <children>
      <CheckBox fx:id="mustIncludeDigits" layoutX="31.0" layoutY="85.0" mnemonicParsing="false" text="Must Include Digits" />
      <CheckBox fx:id="mustIncludeLowerCaseLetters" layoutX="31.0" layoutY="115.0" mnemonicParsing="false" text="Must Include Lower Case Letters" />
      <CheckBox fx:id="mustIncludeUpperCaseLetters" layoutX="31.0" layoutY="146.0" mnemonicParsing="false" text="Must Include Upper Case Letters" />
      <Button fx:id="generatePasswordButton" layoutX="63.0" layoutY="187.0" mnemonicParsing="false" text="Generate Password" />
      <Label layoutX="31.0" layoutY="52.0" text="Minimum Length" />
      <TextField fx:id="minimumLength" layoutX="135.0" layoutY="48.0" prefHeight="25.0" prefWidth="41.0" />
      <Label fx:id="errorTextLabel" layoutX="9.0" layoutY="136.0" prefHeight="17.0" prefWidth="199.0" textFill="RED" />
      <ListView fx:id="passwordHistory" layoutX="26.0" layoutY="219.0" prefHeight="169.0" prefWidth="200.0" />
      <Label fx:id="minLengthErrorText" layoutX="40.0" layoutY="39.0" text="Must be a positive integer" textFill="RED" visible="false" />
      <MenuBar layoutY="1.0">
        <menus>
          <Menu fx:id="file" mnemonicParsing="false" text="File">
            <items>
              <MenuItem fx:id="fileSave" mnemonicParsing="false" text="Save" />
                  <MenuItem fx:id="fileAbout" mnemonicParsing="false" text="About" />
                  <MenuItem fx:id="fileClose" mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </children>
</AnchorPane>
